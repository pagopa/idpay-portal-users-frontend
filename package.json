    "eslint-plugin-react": "^7.26.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jest": "29",
    "jest-environment-jsdom": "29",
    "mkdirp": "^3.0.1",
    "node-fetch": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.7.1",
    "regex-replace": "^2.3.1",
