{
  "name": "idpay-portal-users-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "clean": "npm-run-all clean:*",
    "generate": "npm-run-all generate:*",
    "clean:onboarding-web": "rimraf src/api/generated/onboarding-web && rimraf openApi/generated/onboarding-web-swagger20.json",
    "generate:onboarding-web": "yarn run clean:onboarding-web && mkdirp openApi/generated && api-spec-converter --from=openapi_3 --to=swagger_2 openApi/openapi.onboarding.web.yml > openApi/generated/onboarding-web-swagger20.json && node ./node_modules/@pagopa/selfcare-common-frontend/utils/fixSwagger20ArraySchemaDef.js openApi/generated/onboarding-web-swagger20.json && node ./openApi/scripts/onboarding-web_fixPreGen.cjs && gen-api-models --api-spec openApi/generated/onboarding-web-swagger20.json --out-dir src/api/generated/onboarding-web --no-strict --request-types --response-decoders --client"
  },
  "dependencies": {
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
