    "@types/react": "^17.0.2",
    "@types/react-router-dom": "^5.1.8",
    "axios": "^1.6.0",
    "babel-jest": "^30.0.4",
    "date-fns": "^2.28.0",
    "eslint-plugin-sonarjs": "^0.14.0",
    "formik": "^2.2.9",
    "i18next": "^23.7.11",
    "i18next-browser-languagedetector": "^8.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "keycloak-js": "^26.2.0",
    "oidc-client-ts": "^3.3.0",
    "react": "^18.2.0",
    "react-barcode": "^1.6.1",
